{
  "schema_version": "1.0",
  "name": "participants",
  "display_name": "参与者",
  "description": "参与者级元数据；experimental_group 与互动 group_id 不同。",
  "fields": [
    {
      "name": "subject_id",
      "type": "string",
      "unit": "none",
      "required": true,
      "missing": "forbidden",
      "foreign_key": null,
      "clock": null,
      "description": "参与者唯一标识。"
    },
    {
      "name": "experimental_group",
      "type": "string",
      "unit": "none",
      "required": false,
      "missing": "allowed",
      "foreign_key": null,
      "clock": null,
      "description": "实验条件/组别；不能代替 group_membership.group_id。"
    },
    {
      "name": "age_years",
      "type": "number",
      "unit": "year",
      "required": false,
      "missing": "allowed",
      "foreign_key": null,
      "clock": null,
      "description": "年龄；若未提供则留空。"
    },
    {
      "name": "sex",
      "type": "string",
      "unit": "none",
      "required": false,
      "missing": "allowed",
      "foreign_key": null,
      "clock": null,
      "description": "按研究设计声明的类别，不在导入时重编码。"
    }
  ],
  "unique": [
    [
      "subject_id"
    ]
  ],
  "example_label": "SYNTHETIC_ONLY"
}
