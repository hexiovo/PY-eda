      "type": "number",
      "unit": "s",
      "required": true,
      "missing": "forbidden",
      "foreign_key": null,
      "clock": "clock_domain",
      "description": ""
    },
    {
      "name": "reference_time_s",
      "type": "number",
      "unit": "s",
      "required": true,
      "missing": "forbidden",
      "foreign_key": null,
      "clock": "reference_clock_domain",
      "description": ""
    },
    {
      "name": "channel",
