      "clock": null,
      "description": ""
    },
    {
      "name": "anchor_id",
      "type": "string",
      "unit": "none",
      "required": true,
      "missing": "forbidden",
      "foreign_key": null,
      "clock": null,
      "description": ""
    },
    {
