    },
    {
      "name": "reference_clock_domain",
      "type": "string",
      "unit": "none",
      "required": true,
      "missing": "forbidden",
      "foreign_key": null,
      "clock": null,
      "description": "对齐目标时钟；必须明确声明。"
    },
    {
      "name": "uncertainty_s",
      "type": "number",
      "unit": "s",
      "required": false,
